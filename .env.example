# Copy this file to .env and fill in your real values.
# Get these from your IntaSend dashboard: https://intasend.com  (Settings > API Keys & Webhooks)

# Use the SANDBOX keys first to test everything end-to-end with fake money.
# Switch to LIVE keys only once you've verified real STK pushes work correctly.
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INTASEND_TEST_MODE=true

# The public URL IntaSend will call after a payment succeeds or fails.
# Locally, use ngrok (see README) to get a temporary public URL for this.
# In production, this is your deployed server's URL, e.g. https://api.calestaffloans.co.ke
WEBHOOK_BASE_URL=https://your-deployed-server-url.com

# Your CALE Staff Loans till/paybill number shown to employees for reference/logging
CALE_MPESA_NUMBER=0729473554

# Port the server runs on
PORT=4000

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://calestaffloans.co.ke
